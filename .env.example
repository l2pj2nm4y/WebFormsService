# ============================================================================
# AI Configuration
# ============================================================================

# AI Provider Selection (openrouter or anthropic)
AI_PROVIDER=openrouter

# Model Selection
AI_FACT_MODEL=anthropic/claude-sonnet-4.5
AI_PROMPT_MODEL=anthropic/claude-sonnet-4.5
AI_SIMILARITY_MODEL=anthropic/claude-sonnet-4.5
AI_EMBEDDINGS_MODEL=openai/text-embedding-3-small

# OpenRouter API Key (required when AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anthropic API Key (required when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# Redis Configuration
# ============================================================================

# Local Development Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Lock Configuration
REDIS_DEFAULT_LOCK_TTL=300

# Production Settings (uncomment for production)
# REDIS_HOST=your-redis-cluster.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_SSL=true

# ============================================================================
# Storage Configuration
# ============================================================================

# Storage Type: local | s3
STORAGE_TYPE=local

# Local Storage Settings
LOCAL_STORAGE_ROOT=./storage

# S3 Storage Settings (uncomment for S3 usage)
# S3_BUCKET=your-webforms-service
# S3_ENDPOINT=  # Leave empty for AWS S3, set for MinIO
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ============================================================================
# File Size Limits
# ============================================================================

MAX_SCREENSHOT_SIZE_MB=10
MAX_HTML_SIZE_MB=1
MAX_METADATA_SIZE_KB=100

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# Processing Configuration
# ============================================================================

# Enable parallel quartet processing for improved performance
PROCESSING_ENABLE_PARALLEL_PROCESSING=true

# Maximum number of quartets to process concurrently (1-20)
PROCESSING_QUARTET_CONCURRENCY=5

# ============================================================================
# FastAPI Configuration (Optional)
# ============================================================================

# API_HOST=0.0.0.0
# API_PORT=8000
# API_WORKERS=1
